{
  "manifest_version": 3,
  "name": "Magpie",
  "version": "0.1.0",
  "description": "Highlight web text or a link, right-click to stash it in your local AI-triaged notebook.",
  "key": "",
  "permissions": ["contextMenus", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Magpie"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
